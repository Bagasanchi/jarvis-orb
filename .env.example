# These are examples. Set them in PowerShell; .env is not loaded automatically.
JARVIS_CLOUD_URL=http://127.0.0.1:31415/v1
JARVIS_CLOUD_API_KEY=
JARVIS_CLOUD_MODEL=auto
JARVIS_OLLAMA_URL=http://127.0.0.1:11434
JARVIS_OLLAMA_MODEL=qwen3.5:2b
# Optional vision-capable models, selected separately from the chat model.
JARVIS_VISION_MODEL=
JARVIS_CLOUD_VISION_MODEL=
# auto: Edge online, falling back to Windows offline speech.
JARVIS_TTS_BACKEND=auto
JARVIS_VOICE_INTERRUPT=1
JARVIS_NATURAL_INTERRUPT=0
JARVIS_AUDIO_OUTPUT=speakers
JARVIS_SPEAKER_TAIL_SECONDS=0.4
